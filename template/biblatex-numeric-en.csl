<?xml version="1.0" encoding="utf-8"?>
<!--
  Approximation of biblatex's `numeric` style (bibstyle `standard`,
  sorting=none, maxnames=3) as used by elteikthesis v2.4, English.
  Generated; part of the Typst port of elteikthesis (MIT licence).
  Entry layouts follow biblatex's standard.bbx drivers (article, book,
  inproceedings, incollection, thesis/report/misc).
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="en-US">
  <info>
    <title>elteikthesis biblatex numeric (English)</title>
    <id>elteikthesis-biblatex-numeric-en</id>
    <updated>2026-10-06T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="et-al">et al.</term>
      <term name="and">and</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="month-01" form="short">Jan.</term>
      <term name="month-02" form="short">Feb.</term>
      <term name="month-03" form="short">Mar.</term>
      <term name="month-04" form="short">Apr.</term>
      <term name="month-05" form="short">May</term>
      <term name="month-06" form="short">June</term>
      <term name="month-07" form="short">July</term>
      <term name="month-08" form="short">Aug.</term>
      <term name="month-09" form="short">Sept.</term>
      <term name="month-10" form="short">Oct.</term>
      <term name="month-11" form="short">Nov.</term>
      <term name="month-12" form="short">Dec.</term>
    </terms>
  </locale>
  <macro name="names-author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="4" et-al-use-first="1" initialize="false"/>
      <substitute>
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="4" et-al-use-first="1" initialize="false"/>
          <label form="short" prefix=", "/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="ed-by">
    <names variable="editor" prefix="Ed. by ">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="4" et-al-use-first="1" initialize="false"/>
    </names>
  </macro>
  <macro name="ed-by-after-in">
    <names variable="editor" prefix="ed. by ">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="4" et-al-use-first="1" initialize="false"/>
    </names>
  </macro>
  <!-- In: Booktitle. Ed. by X  /  In: ed. by X (no booktitle) -->
  <macro name="in-container">
    <choose>
      <if variable="container-title">
        <group delimiter=". ">
          <group delimiter=" ">
            <text value="In:"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <text macro="ed-by"/>
        </group>
      </if>
      <else-if variable="editor">
        <group delimiter=" ">
          <text value="In:"/>
          <text macro="ed-by-after-in"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="journal">
    <group delimiter=" ">
      <text value="In:"/>
      <text variable="container-title" font-style="italic"/>
      <group delimiter=".">
        <text variable="volume"/>
        <text variable="issue"/>
      </group>
      <date variable="issued" prefix="(" suffix=")" delimiter=" "><date-part name="month" form="short"/><date-part name="year"/></date>
    </group>
  </macro>
  <!-- "In: Booktitle." with the period inside the italic run (see title-italic) -->
  <macro name="in-container-italic">
    <group delimiter=" ">
      <text value="In:"/>
      <text variable="container-title" font-style="italic" suffix="."/>
    </group>
  </macro>
  <!-- everything after "In: Booktitle. Ed. by X" in an incollection -->
  <macro name="chapter-rest">
    <group delimiter=". ">
      <text macro="volume"/>
      <text macro="series"/>
      <text variable="note"/>
      <choose>
        <if variable="chapter-number">
          <group delimiter=". ">
            <text macro="publisher-date"/>
            <group delimiter=", ">
              <group delimiter=" "><text value="Chap."/><text variable="chapter-number"/></group>
              <text macro="pages"/>
            </group>
          </group>
        </if>
        <else>
          <group delimiter=", ">
            <text macro="publisher-date"/>
            <text macro="pages"/>
          </group>
        </else>
      </choose>
      <text macro="identifiers"/>
    </group>
  </macro>
  <!-- "Location: Institution, Date" (thesis, report) -->
  <macro name="institution-date">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="authority"/>
      </group>
      <text macro="date"/>
    </group>
  </macro>
  <!-- italic title followed by its period inside the italic run, so the
       template can drop the period after a title ending in ! or ? -->
  <macro name="title-italic">
    <text variable="title" font-style="italic" suffix="."/>
  </macro>
  <macro name="volume"><group delimiter=" "><text value="Vol."/><text variable="volume"/></group></macro>
  <!-- series + number; hayagriva passes a @book/@incollection/@inproceedings
       `number` as `issue` -->
  <macro name="series">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
      <text variable="issue"/>
    </group>
  </macro>
  <!-- biblatex organization+location+date: "Location: Organization, Date" -->
  <macro name="organization-date">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="authority"/>
      </group>
      <text macro="date"/>
    </group>
  </macro>
  <macro name="pages"><group delimiter=" "><label variable="page" form="short"/><text variable="page"/></group></macro>
  <macro name="date"><date variable="issued" delimiter=" "><date-part name="month" form="short"/><date-part name="year"/></date></macro>
  <macro name="publisher-place-publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- location: publisher, date -->
  <macro name="publisher-date">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="date"/>
    </group>
  </macro>
  <macro name="identifiers">
    <group delimiter=". ">
      <group delimiter=": ">
        <text value="isbn" font-variant="small-caps"/>
        <text variable="ISBN"/>
      </group>
      <group delimiter=": ">
        <text value="issn" font-variant="small-caps"/>
        <text variable="ISSN"/>
      </group>
      <group delimiter=": ">
        <text value="doi" font-variant="small-caps"/>
        <text variable="DOI"/>
      </group>
      <group delimiter=" ">
        <group delimiter=": ">
          <text value="url" font-variant="small-caps"/>
          <text variable="URL"/>
        </group>
        <date variable="accessed" prefix="(visited on " suffix=")"><date-part name="month" form="numeric-leading-zeros" suffix="/"/><date-part name="day" form="numeric-leading-zeros" suffix="/"/><date-part name="year"/></date>
      </group>
    </group>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!--
    Punctuation: an italic title (or booktitle) carries the period that
    follows it inside the italic run and is joined to what follows with a
    plain space. hayagriva drops that period after a title ending in "."
    and the template's bibliography show rule drops it after "?" "!" "…"
    (biblatex's punctuation tracker). A period that the engine places
    outside the italic run (a ". " delimiter) could not be removed.
  -->
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="names-author"/>
        <choose>
          <if type="book" match="any">
            <group delimiter=" ">
              <text macro="title-italic"/>
              <group delimiter=". ">
                <text variable="edition"/>
                <text macro="volume"/>
                <text macro="series"/>
                <text variable="note"/>
                <text macro="publisher-date"/>
                <text macro="identifiers"/>
              </group>
            </group>
          </if>
          <else-if type="article-journal article-magazine article-newspaper article" match="any">
            <group delimiter=". ">
              <text variable="title" quotes="true"/>
              <choose>
                <if variable="note">
                  <group delimiter=". ">
                    <text macro="journal"/>
                    <group delimiter=", ">
                      <text variable="note"/>
                      <text macro="pages"/>
                    </group>
                  </group>
                </if>
                <else>
                  <group delimiter=", ">
                    <text macro="journal"/>
                    <text macro="pages"/>
                  </group>
                </else>
              </choose>
              <text macro="identifiers"/>
            </group>
          </else-if>
          <else-if type="paper-conference" match="any">
            <!-- inproceedings -->
            <group delimiter=". ">
              <text variable="title" quotes="true"/>
              <choose>
                <if variable="container-title">
                  <group delimiter=" ">
                    <text macro="in-container-italic"/>
                    <group delimiter=". ">
                      <text macro="ed-by"/>
                      <text macro="volume"/>
                      <text macro="series"/>
                      <text variable="note"/>
                      <text variable="authority"/>
                      <group delimiter=", ">
                        <text macro="publisher-date"/>
                        <text macro="pages"/>
                      </group>
                      <text macro="identifiers"/>
                    </group>
                  </group>
                </if>
                <else>
                  <group delimiter=". ">
                    <text macro="in-container"/>
                    <text macro="volume"/>
                    <text macro="series"/>
                    <text variable="note"/>
                    <text variable="authority"/>
                    <group delimiter=", ">
                      <text macro="publisher-date"/>
                      <text macro="pages"/>
                    </group>
                    <text macro="identifiers"/>
                  </group>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="chapter entry-encyclopedia entry-dictionary" match="any">
            <!-- incollection -->
            <group delimiter=". ">
              <text variable="title" quotes="true"/>
              <choose>
                <if variable="container-title">
                  <group delimiter=" ">
                    <text macro="in-container-italic"/>
                    <group delimiter=". ">
                      <text macro="ed-by"/>
                      <text macro="chapter-rest"/>
                    </group>
                  </group>
                </if>
                <else>
                  <group delimiter=". ">
                    <text macro="in-container"/>
                    <text macro="chapter-rest"/>
                  </group>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="thesis" match="any">
            <!-- thesis: "Title". Note. Type. Location: Institution, Date -->
            <group delimiter=". ">
              <text variable="title" quotes="true"/>
              <text variable="note"/>
              <text variable="genre"/>
              <text macro="institution-date"/>
              <text macro="identifiers"/>
            </group>
          </else-if>
          <else-if type="report" match="any">
            <!-- report: Title. Type Number. Note. Location: Institution, Date -->
            <group delimiter=" ">
              <text macro="title-italic"/>
              <group delimiter=". ">
                <group delimiter=" ">
                  <text variable="genre"/>
                  <text variable="number"/>
                </group>
                <text variable="note"/>
                <text macro="institution-date"/>
                <text macro="identifiers"/>
              </group>
            </group>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <!-- online: Title. Note. Organization. Date. url (visited) -->
            <group delimiter=" ">
              <text macro="title-italic"/>
              <group delimiter=". ">
                <text variable="note"/>
                <text variable="authority"/>
                <text macro="date"/>
                <text macro="identifiers"/>
              </group>
            </group>
          </else-if>
          <else>
            <!-- misc, software (biblatex @misc driver; @software is its
                 alias): Title. Howpublished/Note. Location: Organization,
                 Date. No publisher. hayagriva passes `howpublished` as `note`
                 when the entry has no note of its own. -->
            <group delimiter=" ">
              <text macro="title-italic"/>
              <group delimiter=". ">
                <text variable="genre"/>
                <text variable="container-title" font-style="italic"/>
                <text variable="note"/>
                <text macro="organization-date"/>
                <text macro="pages"/>
                <text macro="identifiers"/>
              </group>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
